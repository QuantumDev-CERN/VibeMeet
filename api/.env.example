# ─────────────────────────────────────────────────────────────────────────────
# api/.env.example — canonical env file for the Node API.
# dotenv reads from the process cwd, and you run the API from api/, so this is
# the file that actually gets loaded. Copy to api/.env.
# (The ML service reads its own separate ml/.env — easy to forget it exists.)
# ─────────────────────────────────────────────────────────────────────────────

# Postgres (leave as is if you're using the Docker Compose setup)
DATABASE_URL=postgresql://vibemeet:vibemeet@localhost:5432/vibemeet

# JWT
JWT_SECRET=generate_a_random_secure_string_here
JWT_EXPIRES_IN=7d

# ── Object storage (S3-compatible) ───────────────────────────────────────────
# Any S3-compatible provider works — lib/storage.js is provider-agnostic.
# Cloudflare R2 was dropped as the default because issuing R2 API tokens
# requires a payment method on file. Neither option below does.
#
# OPTION A — MinIO, local, already in docker-compose.yml. Nothing to sign up
# for. These values match the compose file as-is:
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=vibemeet
S3_SECRET_ACCESS_KEY=vibemeet123
S3_BUCKET=vibemeet-photos
S3_PUBLIC_URL=http://localhost:9000/vibemeet-photos
S3_FORCE_PATH_STYLE=true
#
# OPTION B — Backblaze B2. 10 GB free forever, signup explicitly states no
# credit card required, and it's full S3 API parity. Swap in:
#   S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com   <- yours may differ
#   S3_REGION=us-west-004                                <- must match endpoint
#   S3_ACCESS_KEY_ID=<keyID from Application Keys>
#   S3_SECRET_ACCESS_KEY=<applicationKey, shown once>
#   S3_BUCKET=vibemeet-photos
#   S3_PUBLIC_URL=https://f004.backblazeb2.com/file/vibemeet-photos
#   S3_FORCE_PATH_STYLE=true
# See docs/STORAGE.md for the full walkthrough.

# Internal service URLs (leave as is)
ML_SERVICE_URL=http://localhost:8000

# Redis (leave as is)
REDIS_URL=redis://localhost:6379

API_BASE_URL=http://localhost:3001
PORT=3001
CLIENT_ORIGIN=http://localhost:3000
