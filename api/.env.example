# copy this to api/.env and fill in the real values.
# ml service has its own ml/.env, dont forget that one.

# postgres, compose defaults, leave it
DATABASE_URL=postgresql://vibemeet:vibemeet@localhost:5432/vibemeet

# jwt
JWT_SECRET=generate_a_random_secure_string_here
JWT_EXPIRES_IN=7d

# storage, s3 compatible. minio runs locally via compose, these match it.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=vibemeet
S3_SECRET_ACCESS_KEY=vibemeet123
S3_BUCKET=vibemeet-photos
S3_PUBLIC_URL=http://localhost:9000/vibemeet-photos
S3_FORCE_PATH_STYLE=true
# backblaze b2 also works if you want it hosted, see docs/STORAGE.md

# ml service
ML_SERVICE_URL=http://localhost:8000
# shared secret sent as X-ML-Key. Must equal ML_API_KEY in ml/.env (leave both empty locally).
ML_API_KEY=

# brevo, for the otp emails. key from settings > smtp & api, starts with xkeysib-.
# sender has to be verified in brevo or the send fails.
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=VibeMeet

# redis, leave it
REDIS_URL=redis://localhost:6379

API_BASE_URL=http://localhost:3001
PORT=3001
CLIENT_ORIGIN=http://localhost:3000