# Postgres (Leave this as is if you are using your Docker Compose setup)
DATABASE_URL=postgresql://vibemeet:vibemeet@localhost:5432/vibemeet

# JWT
JWT_SECRET=generate_a_random_secure_string_here
JWT_EXPIRES_IN=7d

# Cloudflare R2 (You will need to grab these from your Cloudflare dashboard again)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=gatherly-photos 
R2_PUBLIC_URL=https://your-r2-public-url

# Internal service URLs (Leave as is)
ML_SERVICE_URL=http://localhost:8000

# Redis (Leave as is)
REDIS_URL=redis://localhost:6379

API_BASE_URL=http://localhost:3001